# Скопіюй цей файл у .streamlit/secrets.toml (локально) або встав вміст у Streamlit Cloud -> Settings -> Secrets.
# Файл secrets.toml не потрапляє в git.

# ---- Модель ----
# Gemini: ключ на https://aistudio.google.com/apikey
GEMINI_API_KEY = "..."
# Або Claude: ключ на https://platform.claude.com. Якщо задано обидва, використовується Gemini.
# ANTHROPIC_API_KEY = "sk-ant-..."

# ---- База даних (Supabase): ліміти і збережені результати ----
SUPABASE_URL = "https://<project>.supabase.co"
SUPABASE_KEY = "sb_publishable_..."   # публічний ключ проєкту
CVMAX_DB_TOKEN = "cvmx_..."           # секретний токен сайту, див. supabase/README.md

# ---- Вхід через Google (необов'язково) ----
# Без цього розділу сайт працює без входу.
# [auth]
# redirect_uri = "https://<твій-сайт>.streamlit.app/oauth2callback"
# cookie_secret = "довгий випадковий рядок"
#
# [auth.google]
# client_id = "....apps.googleusercontent.com"
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

