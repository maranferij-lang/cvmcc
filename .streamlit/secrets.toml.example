# Copy this file to .streamlit/secrets.toml (locally) or paste its contents into Streamlit Cloud -> Settings -> Secrets.
# The secrets.toml file does not go into git.

# ---- Model ----
# Gemini: key at https://aistudio.google.com/apikey
GEMINI_API_KEY = "..."
# Or Claude: key at https://platform.claude.com. If both are set, Gemini is used.
# ANTHROPIC_API_KEY = "sk-ant-..."

# ---- Database (Supabase): limits and saved results ----
SUPABASE_URL = "https://<project>.supabase.co"
SUPABASE_KEY = "sb_publishable_..."   # the project's public key
CVMAX_DB_TOKEN = "cvmx_..."           # the site's secret token, see supabase/README.md

# ---- Google sign-in (optional) ----
# Without this section the site works without sign-in.
# [auth]
# redirect_uri = "https://<your-site>.streamlit.app/oauth2callback"
# cookie_secret = "a long random string"
#
# [auth.google]
# client_id = "....apps.googleusercontent.com"
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---- Other ----
# CVMAX_CONTACT = "cvmax.team@gmail.com"
